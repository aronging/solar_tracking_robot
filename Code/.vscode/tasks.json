{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "4 Install Pi packages",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements-pi.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "5 Scan mux channels (lab)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "lab/sensor_scan.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "7 Preflight",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "preflight"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "8 Park (centre servos)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "park"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "9a Check pan sign",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "calibrate-servo",
        "--servo",
        "pan",
        "--check-sign"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "9b Check tilt sign",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "calibrate-servo",
        "--servo",
        "tilt",
        "--check-sign"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "10a Calibrate pan",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "calibrate-servo",
        "--servo",
        "pan"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "10b Calibrate tilt",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "calibrate-servo",
        "--servo",
        "tilt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "10c Fit servo calibration",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "analysis/fit_servo_cal.py",
        "${input:logDir}/servo_cal.csv"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "11 Panel zero (cover panel)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "static-log",
        "--minutes",
        "1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "12 Bench turn (wheels off ground)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "coarse-turn",
        "--bench"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "13 Lamp demo",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "lamp",
        "--seconds",
        "300"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "14 Track (robot on ground)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "track",
        "--robot-on-ground"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "15 Analyze latest log",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "analyze",
        "latest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Sim day (no hardware)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "solar_tracker",
        "sim-day"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "logDir",
      "type": "promptString",
      "description": "Log folder (e.g. logs/20261124_150000Z_calibrate-servo)",
      "default": "logs/"
    }
  ]
}
